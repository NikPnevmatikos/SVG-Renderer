{
  "name": "svg-renderer",
  "version": "0.2.0",
  "description": "Fast, correct SVG rendering for React Native on top of react-native-svg and for React DOM (import from /web), plus a pan/zoom viewer (import from /viewer or /web) with taps resolved in SVG space, selection highlights, badges and built-in controls.",
  "author": "NikPnevmatikos",
  "license": "MIT",
  "homepage": "https://github.com/NikPnevmatikos/SVG-Renderer#readme",
  "bugs": {
    "url": "https://github.com/NikPnevmatikos/SVG-Renderer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NikPnevmatikos/SVG-Renderer.git",
    "directory": "packages/react-native-svg"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/index.js",
  "files": [
    "dist",
    "viewer",
    "web",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc && tsc -p tsconfig.web.json",
    "dev": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "jest",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "CommonJS",
            "moduleResolution": "Node10"
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^svg-core$": "<rootDir>/../core/src/index.ts"
    }
  },
  "keywords": [
    "react-native",
    "svg",
    "renderer",
    "react-native-svg",
    "expo",
    "floor-plan",
    "typescript",
    "viewer",
    "pan",
    "zoom",
    "map",
    "hit-testing",
    "reanimated",
    "gesture-handler",
    "react",
    "web",
    "dom",
    "react-dom"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.73",
    "react-native-svg": ">=15",
    "react-native-gesture-handler": ">=2.12",
    "react-native-reanimated": ">=3.6"
  },
  "dependencies": {
    "svg-core": "^0.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.9",
    "typescript": "~5.9.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./viewer": {
      "types": "./dist/viewer/index.d.ts",
      "react-native": "./dist/viewer/index.js",
      "default": "./dist/viewer/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    },
    "react-native-gesture-handler": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    }
  }
}
