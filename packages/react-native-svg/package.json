{
  "name": "@nikpnevmatikos/svg-renderer",
  "version": "0.0.1",
  "description": "Fast, correct SVG rendering for React Native on top of react-native-svg: real-world designer exports, resolved styles, geometry and hit testing.",
  "author": "NikPnevmatikos",
  "license": "MIT",
  "homepage": "https://github.com/NikPnevmatikos/SVG-Renderer#readme",
  "bugs": {
    "url": "https://github.com/NikPnevmatikos/SVG-Renderer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NikPnevmatikos/SVG-Renderer.git",
    "directory": "packages/react-native-svg"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "clean": "rimraf dist"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "CommonJS",
            "moduleResolution": "Node10"
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^@nikpnevmatikos/svg-core$": "<rootDir>/../core/src/index.ts"
    }
  },
  "keywords": [
    "react-native",
    "svg",
    "renderer",
    "react-native-svg",
    "expo",
    "floor-plan",
    "typescript"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.73",
    "react-native-svg": ">=15"
  },
  "dependencies": {
    "@nikpnevmatikos/svg-core": "0.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-svg": "15.15.4",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.9",
    "typescript": "~5.9.2"
  }
}
